{
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "filesystem": {
      "allowRead": [
        ".",
        "//<agents-max>"
      ],
      "allowWrite": ["."],
      "denyRead": [
        "//<home>/.ssh",
        "//<home>/.aws",
        "//<home>/.gnupg",
        "//<home>/.config",
        "//<home>/.netrc",
        "//<home>/.npmrc",
        "//<home>/.docker",
        "//<home>/.kube",
        "//<home>/.bash_history",
        "//<home>/.zsh_history"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.npmjs.org",
        "registry.yarnpkg.com"
      ]
    }
  },
  "permissions": {
    "deny": [
      "Read(./.env*)",
      "Read(./secrets/**)",
      "Edit(//.claude/settings.json)",
      "Edit(//<agents-max>/**)"
    ],
    "allow": [
      "Read(**)",
      "Edit(**)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(git *)",
      "Bash(node *)",
      "Bash(python3 *)",
      "Bash(tsc *)",
      "Bash(playwright *)",
      "Bash(jest *)",
      "Bash(vitest *)"
    ]
  }
}
